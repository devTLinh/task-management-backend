<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= pageTitle || 'Forgot Password — TaskManager' %></title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/assets/css/auth.css" />
    <link rel="stylesheet" href="/assets/css/app.css" />
    <script defer src="/assets/js/toast.js"></script>
</head>
<body>
    <section class="auth">
        <div class="auth__container">
            <div class="auth__box">
                <div class="auth__logo">
                    <i class="fa-solid fa-layer-group"></i> TaskManager
                </div>
                <h2 class="auth__title">Quên Mật Khẩu?</h2>
                <p class="auth__desc">Nhập địa chỉ email của bạn, chúng tôi sẽ gửi liên kết đặt lại mật khẩu tới hộp thư của bạn.</p>

                <% if (errorMessage) { %>
                <div class="auth__error"><%= errorMessage %></div>
                <% } %>

                <form class="auth__form" method="POST" action="/api/forgot-password">
                    <div class="auth__field">
                        <label><i class="fa-solid fa-envelope"></i> Email</label>
                        <input type="email" name="email" placeholder="you@example.com"
                               value="<%= oldValues ? oldValues.email : '' %>" required />
                    </div>

                    <button class="btn btn--primary" type="submit">Gửi Liên Kết Đặt Lại</button>
                </form>

                <p class="auth__switch">
                    Đã nhớ mật khẩu?
                    <a href="/login">Đăng nhập tại đây</a>
                </p>
                <a href="/" class="auth__back">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại Trang chủ
                </a>
            </div>
        </div>
    </section>
</body>
</html>