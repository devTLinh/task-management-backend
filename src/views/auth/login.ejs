<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login TaskManager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/assets/css/auth.css" />
    <link rel="stylesheet" href="/assets/css/app.css" />
    <script defer src="/assets/js/toast.js"></script>
</head>
<body>
    <section class="auth">
        <div class="auth__container">
            <div class="auth__box">
                <div class="auth__logo">
                    <i class="fa-solid fa-layer-group"></i> TaskManager
                </div>
                <h2 class="auth__title">Welcome Back</h2>
                <p class="auth__desc">Sign in to continue managing your projects and tasks efficiently.</p>

                <% if (errorMessage) { %>
                <div class="auth__error"><%= errorMessage %></div>
                <% } %>

                <form class="auth__form" method="POST" action="/api/login">
                    <div class="auth__field">
                        <label><i class="fa-solid fa-envelope"></i> Email</label>
                        <input type="email" name="email" placeholder="you@example.com" required />
                    </div>

                    <div class="auth__field">
                        <label><i class="fa-solid fa-lock"></i> Password</label>
                        <input type="password" name="password" placeholder="*********" required />
                    </div>

                    <button class="btn btn--primary" type="submit">Log In</button>
                </form>

                <p class="auth__switch">
                    Don't have an account?
                    <a href="/register">Create one</a>
                </p>

                <a href="/" class="auth__back">
                    <i class="fa-solid fa-arrow-left"></i> Back to Home
                </a>
            </div>
        </div>
    </section>

    <script>
        // Optional: frontend toast / message handling
        (function () {
            const form = document.querySelector('.auth__form');
            if (form) {
                form.addEventListener('submit', async function (e) {
                    // You can add frontend validation or async fetch login here if needed
                });
            }
        })();
    </script>
</body>
</html>
